# ==============================================================================
# EstateFlow - Multi-Tenant White-Label Real Estate CRM SaaS Platform
# Environment Configuration
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon) ---
# Direct connection string for Prisma migrations & pooling connection for Next.js queries.
# Example for Supabase:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estateflow"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/estateflow"

# --- SECURITY & AUTHENTICATION ---
# A strong random 32+ character secret used to sign and verify secure session JWT cookies
JWT_SECRET="replace-with-a-very-secure-random-secret-key-at-least-32-chars-long"

# Super Admin Initial Bootstrap Credentials (used for seeding platform administrator)
SUPERADMIN_EMAIL="admin@gmail.com"
SUPERADMIN_PASSWORD="password"
SUPERADMIN_NAME="Platform Administrator"

# Application Base URL (used for invitation links, email links, and webhook callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- META GRAPH API & LEAD ADS WEBHOOKS ---
# From Meta Developers Portal (https://developers.facebook.com)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
# Custom token you choose and configure in Meta App Webhook settings:
META_WEBHOOK_VERIFY_TOKEN="your_custom_meta_webhook_verify_token_here"
# Graph API Version
META_GRAPH_API_VERSION="v22.0"

# --- SUPABASE / OBJECT STORAGE (Optional for logo & document assets) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- EMAIL SERVICE (Optional: Resend / SMTP for user invitations & alerts) ---
RESEND_API_KEY="re_123456789"
EMAIL_FROM="EstateFlow <notifications@estateflow.io>"

